# BrickLens PWA v2.0 — Variables de entorno del proxy servidor (opcionales)
# Configúralas en tu panel de Hostinger (Variables de entorno), Vercel o archivo privado PHP.
# Sin estas claves la app funciona igualmente en modo híbrido (Brickognize en vivo + catálogo/caché local).

# 1. Rebrickable API (GRATIS en https://rebrickable.com/api/ -> genera tu API Key)
# Desbloquea catálogo de +15.000 minifiguras, despiece real por pieza y cruce de piezas sueltas.
REBRICKABLE_API_KEY=

# 2. BrickOwl API (GRATIS en https://www.brickowl.com/mystuff/api_keys)
# Desbloquea precios en vivo de tiendas europeas BrickOwl.
BRICKOWL_API_KEY=

# 3. eBay Browse API (GRATIS en https://developer.ebay.com/ — App de producción)
# Desbloquea cotizaciones reales en EUR de eBay España / Europa.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_ES

# Puerto del servidor Node.js (Hostinger asigna PORT automáticamente)
PORT=3000
