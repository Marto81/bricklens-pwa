<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Mapear rutas limpias /api/<endpoint> a /api/<endpoint>.php en hosting compartido Apache
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/([^/]+)$ api/$1.php [L,QSA]

  # Dejar pasar el proxy PHP y archivos reales sin reescritura
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback SPA hacia index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Evitar caché agresiva en el Service Worker y el Manifiesto PWA
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
